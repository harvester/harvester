#!/bin/bash
# Validate and generate addon manifests from the in-tree addons/ directory.
#
# Prior to the addon-repository-consolidation, this cloned
# github.com/harvester/addons. Addons now live in-tree, but generation still
# runs in the repository's Docker build environment so host Go tooling is not
# required.
set -e

TOP_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# Generation must describe the current metadata exactly. Remove previous
# output first so an addon that was renamed, retired, or moved to standalone
# cannot leak into a later upgrade bundle.
rm -rf "${TOP_DIR}/dist/prepare-addons"
mkdir -p "${TOP_DIR}/dist"

docker_pull_args=()
if [ -n "${MK_DOCKER_PULL:-}" ]; then
    docker_pull_args+=("${MK_DOCKER_PULL}")
fi

docker build "${docker_pull_args[@]}" \
    --progress="${MK_DOCKER_PROGRESS:-plain}" \
    --build-arg MK_REPO_ID \
    --build-arg MK_HOST_ARCH \
    --target generate-addons-output \
    --output "type=local,dest=${TOP_DIR}/dist" \
    -f "${TOP_DIR}/Dockerfile" "${TOP_DIR}"

# sprint releases: pin the nvidia-driver-toolkit tag in the generated manifests
# (they are shipped in the upgrade image and applied by upgrade_addon)
source "${TOP_DIR}/scripts/version"
source "${TOP_DIR}/scripts/lib/addon"
freeze_sprint_image_tags "${TOP_DIR}/dist/prepare-addons/addons-manifests"
