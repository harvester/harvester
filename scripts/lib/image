#!/bin/bash

# Prefix registry to images
# rancher -> docker.io/library/rancher
# rancher/rancher -> docker.io/rancher/rancher
# test.com/rancher/rancher -> test.com/rancher/rancher
normalize_image()
{
  echo $1 | awk -F '/' '{if(NF>=3){print $0} else if(NF==2){print "docker.io/"$0}else if(NF==1){print "docker.io/library/"$0}}'
}

# Validate a registry supplied at a build boundary and return it unchanged.
# Registry values are host/path prefixes, not URLs, and must not end in '/'.
validate_registry()
{
  local registry=$1
  local name=${2:-Image registry}
  if [[ -z "${registry}" ]]; then
    echo "${name} is required" >&2
    return 1
  fi
  if [[ "${registry}" == *://* ]]; then
    echo "${name} must not include a URL scheme" >&2
    return 1
  fi
  if [[ "${registry}" == */ ]]; then
    echo "${name} must not end with '/'" >&2
    return 1
  fi
  echo "${registry}"
}

# Resolve the registry for an image category. Community builds always use the
# public default. Prime builds must receive the registry at build time; Prime
# registry addresses are intentionally never stored in this repository.
#
#   harvester    — Harvester component images referenced by Harvester charts
#   rancher      — Rancher, RKE2, rancherd bootstrap images, system-default-registry
#   monitoring   — rancher-monitoring/rancher-logging images; falls back to the
#                  rancher registry when MK_MONITORING_REGISTRY is unset
#   suse-storage — SUSE Storage; defaults to the public dp.apps.rancher.io
resolve_registry()
{
  local category=$1

  case "${category}" in
    harvester)
      if [[ "${MK_PRIME_BUILD:-}" == "true" ]]; then
        if [[ -z "${MK_HARVESTER_PRIME_REGISTRY:-}" ]]; then
          echo "MK_HARVESTER_PRIME_REGISTRY is required when MK_PRIME_BUILD=true" >&2
          return 1
        fi
        validate_registry "${MK_HARVESTER_PRIME_REGISTRY}" MK_HARVESTER_PRIME_REGISTRY
        return
      fi
      echo "docker.io"
      ;;
    rancher)
      if [[ "${MK_PRIME_BUILD:-}" == "true" ]]; then
        if [[ -z "${MK_RANCHER_PRIME_REGISTRY:-}" ]]; then
          echo "MK_RANCHER_PRIME_REGISTRY is required when MK_PRIME_BUILD=true" >&2
          return 1
        fi
        validate_registry "${MK_RANCHER_PRIME_REGISTRY}" MK_RANCHER_PRIME_REGISTRY
        return
      fi
      echo "docker.io"
      ;;
    monitoring)
      if [[ "${MK_PRIME_BUILD:-}" == "true" ]]; then
        if [[ -n "${MK_MONITORING_REGISTRY:-}" ]]; then
          validate_registry "${MK_MONITORING_REGISTRY}" MK_MONITORING_REGISTRY
          return
        fi
        resolve_registry rancher
        return
      fi
      echo "docker.io"
      ;;
    suse-storage)
      validate_registry "${MK_SUSE_STORAGE_REGISTRY:-dp.apps.rancher.io}" MK_SUSE_STORAGE_REGISTRY
      ;;
    *)
      echo "Unknown image registry category: ${category}" >&2
      return 1
      ;;
  esac
}

# Back-compat wrapper: the Rancher/RKE2/rancherd category was originally the
# only one and had its own function name.
resolve_rancher_registry()
{
  resolve_registry rancher
}

# Render a registry-less image inventory into a concrete image list.
# Source entries must use the form namespace/repository:tag. Blank lines and
# comments are ignored so the result can be passed directly to docker image save.
render_image_list()
{
  local in_file=$1
  local registry
  local out_file=$3
  local image first_component

  if ! registry=$(validate_registry "$2"); then
    return 1
  fi

  : > "${out_file}"
  while IFS= read -r image || [[ -n "${image}" ]]; do
    image=${image%$'\r'}
    [[ -z "${image}" || "${image}" == \#* ]] && continue
    if [[ "${image}" == /* || "${image}" != */* ]]; then
      echo "Registry-less image must include a namespace: ${image}" >&2
      return 1
    fi
    if [[ "${image##*/}" != *:* && "${image}" != *@* ]]; then
      echo "Image inventory entry must include a tag or digest: ${image}" >&2
      return 1
    fi

    first_component=${image%%/*}
    if [[ "${first_component}" == *.* || "${first_component}" == *:* || "${first_component}" == "localhost" ]]; then
      echo "Image inventory entry must not include a registry: ${image}" >&2
      return 1
    fi
    echo "${registry}/${image}" >> "${out_file}"
  done < "${in_file}"
}

# Rewrite a downloaded image list to a different registry while retaining each
# repository path and tag. Inputs without an explicit registry are first
# normalized to docker.io.
rewrite_image_list_registry()
{
  local in_file=$1
  local registry
  local out_file=$3
  local image normalized

  if ! registry=$(validate_registry "$2"); then
    return 1
  fi

  : > "${out_file}"
  while IFS= read -r image || [[ -n "${image}" ]]; do
    image=${image%$'\r'}
    [[ -z "${image}" || "${image}" == \#* ]] && continue
    normalized=$(normalize_image "${image}")
    echo "${registry}/${normalized#*/}" >> "${out_file}"
  done < "${in_file}"
}

save_image_list()
{
  local app=$1
  local in_file=$2
  local out_file=$3
  local images
  local image

  case $in_file in
    http*)
      if ! images=$(curl -fL --no-progress-meter $in_file); then
        echo "Failed to download image list from ${in_file}" >&2
        exit 1
      fi
      ;;
    *)
      images=$(<$in_file)
      ;;
  esac

  local repository
  local want

  for image in $images; do
    repository=${image%:*}

    # Add docker.io prefix if there is no prefixed registry URL
    repository=$(normalize_image $repository)

    # The allow list identifies repositories independently of their registry.
    repository=${repository#*/}

    if yq -e e ".${app}[] | select(. == \"${repository}\")" ${SCRIPTS_DIR}/images/allow.yaml &>/dev/null; then
      want+="$(normalize_image $image)"$'\n'
    fi
  done

  if [ -z "$want" ]; then
    echo "No images from ${in_file} matched allow.yaml's \"${app}\" list" >&2
    exit 1
  fi

  echo -n "$want" | sort | uniq > $out_file
}

pull_images() {
  local image_list=$1
  local image_cache_db=${SCRIPTS_DIR}/images/cache.yaml
  local repository

  if [ -z "$USE_LOCAL_IMAGES" ]; then
    echo "Pulling images..."
    for image in $(cat $image_list); do
      docker image pull --quiet $image
    done
    return
  fi

  # If a tag is specified via the ENV USE_LOCAL_IMAGES, then directly check this image and continue.
  # For example: export USE_LOCAL_IMAGES=fix6486-head
  # This will let `make build-iso` from Harvester local development much easier.

  # If an image is in the exlcude list or its tag ends with "-head", we always pull it.
  # Otherwise, we check if the image exists on the system. If yes, we do nothing.
  for image in $(cat $image_list); do
    repository=$(echo $image | awk -F ':' '{print $1}')
    tag=$(echo $image | awk -F ':' '{print $2}')

    if [[ $USE_LOCAL_IMAGES == $tag ]]; then
      echo "[ImageCache] $image meets the specified tag from USE_LOCAL_IMAGES."
      if docker image inspect $image &>/dev/null; then
        echo "[ImageCache] $image exists."
        continue
      fi
    fi

    if yq -e e ".exclude.repos[] | select(. == \"${repository}\")" $image_cache_db &>/dev/null; then
      echo "[ImageCache] $image is in the exclude.repos list."
    elif [[ $tag == *"-head" ]]; then
      echo "[ImageCache] $image has \"-head\" suffix."
    elif yq -e e ".exclude.tags[] | select(. == \"${tag}\")" $image_cache_db &>/dev/null; then
      echo "[ImageCache] $image is in the exclude.tags list."
    else
      if docker image inspect $image &>/dev/null; then
        echo "[ImageCache] $image exists."
        continue
      fi
    fi

    echo "[ImageCache] $image: pulling..."
    docker pull $image
  done
}

# is_cache_excluded IMAGE
# Returns 0 (true) if IMAGE should bypass the volume cache and always be pulled
# from the registry. Checks: hard-coded volatile tags, then scripts/images/cache.yaml
# .exclude.tags[] and .exclude.repos[].
# SCRIPTS_DIR must be set by the caller.
_IMAGE_VOLATILE_TAGS="master master-head main main-head dev dev-head"

is_cache_excluded() {
  local image="$1"
  local repo="${image%:*}"
  local tag="${image##*:}"

  local volatile_tag
  for volatile_tag in ${_IMAGE_VOLATILE_TAGS}; do
    [[ "${tag}" == "${volatile_tag}" ]] && return 0
  done

  local cache_yaml="${SCRIPTS_DIR}/images/cache.yaml"
  if [[ -f "${cache_yaml}" ]]; then
    if yq -e ".exclude.tags[] | select(. == \"${tag}\")" "${cache_yaml}" &>/dev/null 2>&1; then
      return 0
    fi
    if yq -e ".exclude.repos[] | select(. == \"${repo}\")" "${cache_yaml}" &>/dev/null 2>&1; then
      return 0
    fi
  fi

  return 1
}

save_image()
{
  local image_type=$1
  local bundle_dir=$2
  local image_list=$3
  local save_dir=$4

  local archive_name="$(basename ${image_list%.txt}).tar"
  local archive_file="${save_dir}/${archive_name}"
  pull_images $image_list
  docker image save $(<${image_list}) | zstd -o "${archive_file}.zst"

  add_image_list_to_metadata $image_type $bundle_dir $image_list "${archive_file}.zst"
}

# Add image list to bundle metadata
add_image_list_to_metadata() {
  local image_type=$1
  local bundle_dir=$2
  local image_list=$3
  local image_archive=$4

  local metadata="$bundle_dir/metadata.yaml"
  local rel_image_list
  local rel_image_archive

  rel_image_list="${image_list#"$bundle_dir"}"

  if [ "$rel_image_list" = "$image_list" ]; then
    echo "Image list file $image_list is not in $bundle_dir"
    exit 1
  fi

  rel_image_archive="${image_archive#"$bundle_dir"}"
  if [ "$rel_image_archive" = "$image_archive" ]; then
    echo "Image archive $image_archive is not in $bundle_dir"
    exit 1
  fi

  if [ ! -e  $metadata ]; then
    cat > $metadata <<'EOF'
images:
  common: []
  rke2: []
  agent: []
EOF
  fi

  IMAGE_LIST="$rel_image_list" \
    IMAGE_ARCHIVE="$rel_image_archive" \
    yq -e --prettyPrint e ".images.$image_type += [{\"list\": strenv(IMAGE_LIST), \"archive\": strenv(IMAGE_ARCHIVE)}]" $metadata -i
}
