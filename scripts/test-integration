#!/bin/bash
# DESC: Runs the integration tests
set -e

source $(dirname $0)/version

# The root of the harvester directory
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

export PRELOADING_IMAGES="rancher/harvester-webhook:${TAG}"
export WEBHOOK_IMAGE_NAME="rancher/harvester-webhook:${TAG}"

echo "Running integration tests"

# INTEGRATION_FOCUS: only run the specs that match this regular expression
# INTEGRATION_PATH:  only run the suites in this path, relative to the repository root
GINKGO_ARGS=()
if [ -n "${INTEGRATION_FOCUS:-}" ]; then
	echo "Only running specs matching: ${INTEGRATION_FOCUS}"
	GINKGO_ARGS+=(-focus "${INTEGRATION_FOCUS}")
	# Ginkgo counts the specs per suite, so this is only safe if a single suite is selected.
	if [ -n "${INTEGRATION_PATH:-}" ]; then
		GINKGO_ARGS+=(-fail-on-empty)
	fi
fi
TEST_PATH="${ROOT_DIR}/${INTEGRATION_PATH:-tests/integration/...}"

CGO_ENABLED=0 ginkgo -r -v -trace -tags=test \
  -fail-fast -slow-spec-threshold=2m -timeout=60m "${GINKGO_ARGS[@]}" "${TEST_PATH}"
